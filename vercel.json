{
  "redirects": [
    { "source": "/powerball", "destination": "/powerball/numbers.html", "permanent": true },
    { "source": "/megamillions", "destination": "/megamillions/numbers.html", "permanent": true },
    { "source": "/learn", "destination": "/learn/index.html", "permanent": true },
    { "source": "/learn/:slug", "destination": "/learn/:slug.html", "permanent": true },
    { "source": "/:page(about|faq|privacy|terms|contact|offline)", "destination": "/:page.html", "permanent": true },
    { "source": "/powerball/:page(numbers|results)", "destination": "/powerball/:page.html", "permanent": true },
    { "source": "/megamillions/:page(numbers|results)", "destination": "/megamillions/:page.html", "permanent": true },
    { "source": "/powerball/number/:n", "destination": "/powerball/number/:n.html", "permanent": true },
    { "source": "/powerball/powerball/:n", "destination": "/powerball/powerball/:n.html", "permanent": true },
    { "source": "/megamillions/number/:n", "destination": "/megamillions/number/:n.html", "permanent": true },
    { "source": "/megamillions/megaball/:n", "destination": "/megamillions/megaball/:n.html", "permanent": true },
    { "source": "/scratch", "destination": "/#section-stats", "permanent": true },
    { "source": "/scratch.html", "destination": "/#section-stats", "permanent": true },
    { "source": "/scratcher", "destination": "/#section-stats", "permanent": true },
    { "source": "/scratcher.html", "destination": "/#section-stats", "permanent": true },
    { "source": "/scratch-cards", "destination": "/#section-stats", "permanent": true },
    { "source": "/bingo", "destination": "/#section-stats", "permanent": true },
    { "source": "/bingo.html", "destination": "/#section-stats", "permanent": true },
    { "source": "/777", "destination": "/#section-stats", "permanent": true },
    { "source": "/777.html", "destination": "/#section-stats", "permanent": true },
    { "source": "/games", "destination": "/#section-stats", "permanent": true },
    { "source": "/games.html", "destination": "/#section-stats", "permanent": true },
    { "source": "/mini-game", "destination": "/#section-stats", "permanent": true },
    { "source": "/mini-game.html", "destination": "/#section-stats", "permanent": true },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "lotterymigo.com" }],
      "destination": "https://www.lotterymigo.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/content/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
